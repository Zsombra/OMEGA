      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "classification",
        "vocab": [
          "expanding",
          "contracting",
          "normal"
        ]
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value",
        "trajectory"
      ]
    },
    {
      "metric": "REGIME_MOM",
      "label": "Regime · momentum",
      "code": "regMom",
      "gloss": "the platform-classified momentum regime",
      "family": "regime",
      "study": "regimeContext",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "classification",
        "vocab": [
          "bullish",
          "bearish",
          "neutral",
          "diverging"
        ]
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value",
        "trajectory"
      ]
    },
    {
      "metric": "REGIME_STATE",
      "label": "Regime · state",
      "code": "regState",
      "gloss": "the market structure the platform classified — trend or range, up or down — at the confirmed close; its volatility and warnings are read beside it",
      "family": "regime",
      "study": "regimeVerdict",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "classification",
        "vocab": [
          "bull trend",
          "bear trend",
          "bull range",
          "bear range",
          "fallback"
        ]
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value"
      ]
    },
    {
      "metric": "REGIME_CONVICTION",
      "label": "Regime · conviction",
      "code": "regConv",
      "gloss": "how strongly the structure label holds: a trend’s tier moves with its volatility and its agreement with swing structure, a range’s with that agreement alone; never moved by a warning, and NOT how comfortably a gate cleared (the margins carry that)",
      "family": "regime",
      "study": "regimeVerdict",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "classification",
        "vocab": [
          "maximum",
          "high",
          "medium",
          "low",
          "uncertain"
        ]
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value"
      ]
    },
    {
      "metric": "REGIME_RUN_BARS",
      "label": "Regime · run length",
      "code": "regBars",
      "gloss": "consecutive confirmed bars the structure label has held, unbounded — a warning or a volatility move inside it does not restart it",
      "family": "regime",
      "study": "regimeVerdict",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "numeric",
        "unit": "count",
        "precision": 0
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value",
        "spread"
      ]
    },
    {
      "metric": "REGIME_TREND_GATE",
      "label": "Regime · trend gate",
      "code": "regGate",
      "gloss": "whether this bar cleared the ADX trending gate (27), dropped below the exit gate (23), or landed in the buffer between them where the PREVIOUS bar’s trend is carried forward rather than re-confirmed",
      "family": "regime",
      "study": "regimeTrendEvidence",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "classification",
        "vocab": [
          "cleared",
          "held",
          "dropped"
        ]
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value"
      ]
    },
    {
      "metric": "REGIME_TREND_MARGIN",
      "label": "Regime · trend margin",
      "code": "regMargin",
      "gloss": "ADX points by which the current trend label survives — distance above the exit gate (23) while trending, below the entry gate (27) while ranging; small inside the buffer zone",
      "family": "regime",
      "study": "regimeTrendEvidence",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "numeric",
        "unit": "oscillator",
        "precision": 1,
        "range": {
          "min": 0,
          "max": 100
        }
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value",
        "spread"
      ]
    },
    {
      "metric": "REGIME_TREND_SOURCE",
      "label": "Regime · trend source",
      "code": "regSrc",
      "gloss": "which evidence class voted the trend direction — a decisive DI spread, or the EMA-vs-SMA fallback that fires precisely when the DI spread is indecisive",
      "family": "regime",
      "study": "regimeTrendEvidence",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "classification",
        "vocab": [
          "di spread",
          "ema fallback"
        ]
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value"
      ]
    },
    {
      "metric": "REGIME_DI_SPREAD",
      "label": "Regime · DI spread",
      "code": "regDI",
      "gloss": "DI+ − DI− in points on the regime timeframe — the value of the DIplus14_DIminus14_spread column read at the regime rung, not at a lower anchor — gated against the directional threshold (5)",
      "family": "regime",
      "study": "regimeTrendEvidence",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "numeric",
        "unit": "points",
        "precision": 2,
        "range": {
          "min": -100,
          "max": 100
        }
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value"
      ]
    },
    {
      "metric": "REGIME_VOL_ATR_RATIO",
      "label": "Regime · ATR ratio",
      "code": "regAtrR",
      "gloss": "the classifier’s ATR reading against its own trailing-window mean; expands above 1.05, contracts below 0.9",
      "family": "regime",
      "study": "regimeVolatilityEvidence",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "numeric",
        "unit": "ratio",
        "precision": 2
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value",
        "spread"
      ]
    },
    {
      "metric": "REGIME_VOL_BBW_RATIO",
      "label": "Regime · BB-width ratio",
      "code": "regBbwR",
      "gloss": "the classifier’s Bollinger-width reading against its own trailing-window mean; the volatility label needs THIS and the ATR ratio to agree, so either alone can hold it back",
      "family": "regime",
      "study": "regimeVolatilityEvidence",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "numeric",
        "unit": "ratio",
        "precision": 2
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value",
        "spread"
      ]
    },
    {
      "metric": "REGIME_MOM_BULL_VOTES",
      "label": "Regime · bullish votes",
      "code": "regBull",
      "gloss": "how many of the four momentum inputs voted bullish (0–4)",
      "family": "regime",
      "study": "regimeMomentumVotes",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "numeric",
        "unit": "count",
        "precision": 0
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value",
        "spread"
      ]
    },
    {
      "metric": "REGIME_MOM_BEAR_VOTES",
      "label": "Regime · bearish votes",
      "code": "regBear",
      "gloss": "how many of the four momentum inputs voted bearish (0–4) — read against the bullish tally, a 3–1 is not a 2–1",
      "family": "regime",
      "study": "regimeMomentumVotes",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "numeric",
        "unit": "count",
        "precision": 0
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value",
        "spread"
      ]
    },
    {
      "metric": "REGIME_CRASH_MARGIN",
      "label": "Regime · crash margin",
      "code": "regCrash",
      "gloss": "standard deviations by which the crash reading — the fifteen-bar rate of change counted in the coin's own one-bar volatility before it — sits above the crash gate (-3) — how far the crash warning was from being raised",
      "family": "regime",
      "study": "regimeCrashEvidence",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "numeric",
        "unit": "oscillator",
        "precision": 2
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value",
        "spread"
      ]
    },
    {
      "metric": "REGIME_CRASH_LATCH",
      "label": "Regime · crash latch",
      "code": "regLatch",
      "gloss": "the crash latch is armed: set by a crash reading below the gate, cleared when the reading recovers to the exit gate — while armed the reading carries the crash warning",
      "family": "regime",
      "study": "regimeCrashEvidence",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "classification",
        "vocab": [
          "armed",
          "clear"
        ]
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value"
      ]
    },
    {
      "metric": "REGIME_WARNING_CRASH",
      "label": "Regime · crash warning",
      "code": "regWCrash",
      "gloss": "whether the reading carries the crash warning: raised by a crash reading below the gate (-3) and held by the crash latch until the reading recovers to the exit gate",
      "family": "regime",
      "study": "regimeVerdict",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "classification",
        "vocab": [
          "raised",
          "clear"
        ]
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value"
      ]
    },
    {
      "metric": "REGIME_WARNING_DIVERGENCE",
      "label": "Regime · divergence warning",
      "code": "regWDiv",
      "gloss": "whether the reading carries the momentum-divergence warning: momentum diverging from price while the structure is a trend",
      "family": "regime",
      "study": "regimeVerdict",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "classification",
        "vocab": [
          "raised",
          "clear"
        ]
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value"
      ]
    }
  ],
