{
  "category": "regime",
  "metrics": [
    {
      "metric": "REGIME_TREND",
      "label": "Regime · trend",
      "code": "regTrend",
      "gloss": "the platform-classified trend regime",
      "family": "regime",
      "study": "regimeContext",
      "provenance": "battleGridDerived",
      "nativeOutput": {
        "kind": "classification",
        "vocab": [
