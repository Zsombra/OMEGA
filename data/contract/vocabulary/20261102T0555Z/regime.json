          "ranging"
        ]
      },
      "timeframeMode": "timeless",
      "transformIds": [
        "value",
        "trajectory"
      ]
    },
    {
      "metric": "REGIME_VOL",
      "label": "Regime · volatility",
      "code": "regVol",
      "gloss": "the platform-classified volatility regime",
