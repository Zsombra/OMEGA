  "study": "marketStructure",
  "rankScope": null,
  "gloss": "how many bars since the nearest sellside liquidity pool below price formed, through this one, touched or rejected it — levelInteraction's touch_* or reject_* against the pool at exact contact (buffer 0) — a sellside pool forms on the bar that confirms an equal low — a recorded pivot low of length 3 within 0.1 × ATR(200) of the previous recorded one, the EQL rule — at the newer pivot's price, and stays intact until a close below it retires it; several pools are kept at once — computed by the server over this timeframe’s bars, in Smart Money Concepts legs: a pivot high of length n is a high above every high of the n bars after it, a pivot low a low below every low of the n bars after it, recorded alternately as the leg turns; absent when no pool is intact, and absent where a pool formed before the bars read prove the equal pivots could be nearer, so it can read absent while price trades beyond every close the bars read since then",
  "subjectKinds": [
    "evaluated-coin",
    "benchmark"
  ],
  "parameters": {
    "equalBars": {
      "required": false,
      "description": "The equal highs and lows’ pivot length, each side.",
      "defaultValue": 3,
      "minimum": 1,
      "bound": "depth",
      "maximum": 2435
    },
    "equalThreshold": {
      "required": false,
      "description": "How close two pivots must be to be equal, as a fraction of ATR(200) at the deciding bar.",
