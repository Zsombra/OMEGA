{
  "metric": "PRIOR_LONDON_SUPPLY_EDGE",
  "label": "Supply zone edge (prior London 08–13 UTC)",
  "code": "pLondonSupEdge",
  "family": "levels",
  "nativeOutput": {
    "kind": "numeric",
    "unit": "price",
    "precision": 2
  },
  "outputKind": "scalar",
  "timeframeMode": "timeless",
  "transforms": [
    {
      "id": "value",
      "metricParametersAccepted": true,
      "maximums": {
        "offset": 0
      },
      "bounds": {
        "offset": "lookback"
      }
    },
    {
      "id": "distance",
      "metricParametersAccepted": true
    },
    {
      "id": "spread",
      "metricParametersAccepted": true
    },
    {
      "id": "levelInteraction",
      "metricParametersAccepted": true,
      "maximums": {
        "buffer": 500,
        "touchAtr": 2
      },
      "bounds": {
        "buffer": "range",
        "touchAtr": "range"
      }
    }
  ],
  "study": "priorTradingSessions",
  "provenance": "battleGridDerived",
  "rankScope": null,
  "gloss": "the zone's inner edge — that bin's bound farther from the high, on the supply zone of the previous completed London 08–13 UTC trading session (08:00–13:00 UTC): its range cut into 50 equal bins counted from the window high, each holding the volume of the 1m bars whose high lies in it, and the zone runs from the high to the first bin whose running share of the window's volume exceeds 10% — a BattleGrid variant of LuxAlgo “Supply and Demand Daily” (Intrabar TF 1m) over this session in place of the day; fixed once the window closes and absent until then; absent where the window has no range or no volume or no bin exceeds the threshold, and for a window that closed before these levels were first stored",
  "subjectKinds": [
    "evaluated-coin",
    "benchmark"
  ],
  "parameters": {
    "supplyDemandThreshold": {
      "required": false,
      "description": "LuxAlgo’s Threshold %: the share of the window’s volume, counted in bins from its high (supply) or low (demand), a zone must exceed to end.",
      "defaultValue": 10,
      "minimum": 0,
      "maximum": 100,
      "step": 0.5,
      "bound": "range"
    },
    "supplyDemandResolution": {
      "required": false,
      "description": "LuxAlgo’s Resolution: the equal bins the window’s range is cut into. Off its default the server rebuilds the window from its 1m bars, which reach only the last two UTC days.",
      "defaultValue": 50,
      "minimum": 2,
      "maximum": 500,
      "step": 1,
      "bound": "range"
    }
  },
