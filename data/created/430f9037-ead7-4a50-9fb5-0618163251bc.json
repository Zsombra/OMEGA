  "conditions": [
   {
    "conditionKey": "BREAK_ABOVE_NARROW_VALUE",
    "name": "Narrow prior value and the close accepted above its high",
    "definition": {
     "kind": "group",
     "op": "ALL",
     "members": [
      {
       "kind": "conditionRef",
       "conditionKey": "NARROW_PRIOR_VALUE"
      },
      {
       "kind": "clause",
       "column": {
        "sectionKey": "custom:97039457-d08c-8aff-8d2e-1517c7645cff",
        "header": "pTpoVAH_close_spread"
       },
       "op": "lte",
       "value": -0.05
      }
     ]
    },
    "verdict": "UP",
    "required": false,
    "exit": false,
    "clock": "LIVE",
    "closes": 1
   },
   {
    "conditionKey": "BREAK_BELOW_NARROW_VALUE",
    "name": "Narrow prior value and the close accepted below its low",
    "definition": {
     "kind": "group",
     "op": "ALL",
     "members": [
      {
       "kind": "conditionRef",
       "conditionKey": "NARROW_PRIOR_VALUE"
      },
      {
       "kind": "clause",
       "column": {
        "sectionKey": "custom:97039457-d08c-8aff-8d2e-1517c7645cff",
        "header": "pTpoVAL_close_spread"
       },
       "op": "gte",
       "value": 0.05
      }
     ]
    },
    "verdict": "DOWN",
    "required": false,
    "exit": false,
    "clock": "LIVE",
    "closes": 1
   },
   {
    "conditionKey": "COILED_INSIDE_NARROW",
    "name": "Narrow prior value, close still inside it: coiled, not broken",
    "definition": {
     "kind": "group",
     "op": "ALL",
     "members": [
      {
       "kind": "conditionRef",
       "conditionKey": "NARROW_PRIOR_VALUE"
      },
      {
       "kind": "clause",
       "column": {
        "sectionKey": "custom:97039457-d08c-8aff-8d2e-1517c7645cff",
        "header": "pTpoVAL_close_spread"
       },
       "op": "lt",
       "value": 0.05
      },
      {
       "kind": "clause",
       "column": {
        "sectionKey": "custom:97039457-d08c-8aff-8d2e-1517c7645cff",
        "header": "pTpoVAH_close_spread"
       },
       "op": "gt",
       "value": -0.05
      }
     ]
    },
    "verdict": "NEITHER",
    "required": false,
    "exit": false,
    "clock": "LIVE",
    "closes": 1
   },
   {
    "conditionKey": "WIDE_PRIOR_VALUE",
    "name": "Prior value area not narrow: no compression to break",
    "definition": {
     "kind": "group",
     "op": "NOT",
     "members": [
      {
       "kind": "conditionRef",
       "conditionKey": "NARROW_PRIOR_VALUE"
      }
     ]
    },
    "verdict": "NEITHER",
    "required": false,
    "exit": false,
    "clock": "LIVE",
    "closes": 1
   },
   {
    "conditionKey": "NARROW_PRIOR_VALUE",
    "name": "Prior value-area width in the bottom quartile of the universe",
    "definition": {
     "kind": "clause",
     "column": {
      "sectionKey": "custom:97039457-d08c-8aff-8d2e-1517c7645cff",
      "header": "pTpoVAH_pTpoVAL_spread"
     },
     "op": "lte",
     "value": 2.3
    },
    "verdict": null,
    "required": true,
    "exit": false,
    "clock": "LIVE",
    "closes": 1
   },
   {
    "conditionKey": "BROKEN_OUT",
    "name": "The close has broken out of the narrow prior value area, either side",
    "definition": {
     "kind": "group",
     "op": "ANY",
     "members": [
      {
       "kind": "conditionRef",
       "conditionKey": "BREAK_ABOVE_NARROW_VALUE"
      },
      {
       "kind": "conditionRef",
       "conditionKey": "BREAK_BELOW_NARROW_VALUE"
      }
     ]
    },
    "verdict": null,
    "required": true,
    "exit": false,
    "clock": "LIVE",
    "closes": 1
   }
  ],
