  "scope": "PRIVATE",
  "systemKey": null,
  "name": "OMEGA-TEST: TPO Compression Breakout",
  "description": "A narrow prior-session value area is a coiled auction. Two required gates - width in the bottom quartile, and a close accepted outside the area - block anything else before the agent is billed. UP above the prior value high, DOWN below the prior value low, NEITHER while coiled or when value is wide. Prior-session columns only, live all day. Weights, levels and trailing mirror the vendor's validated volatility-compression breakout playbook.",
  "tagline": "A narrow prior value area is a coil; a close accepted outside it is the break",
  "visibility": "UNLISTED",
  "timeframe": "1h",
  "cadence": "INTRADAY",
  "regimeTimeframe": "4h",
  "marketReadText": "",
  "sections": [
