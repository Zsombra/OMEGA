{
 "strategy": {
  "id": "6c58dd38-9d27-4a80-98c4-3a88513eb2db",
  "ownerUserId": "bb334a1e-2ac2-4956-8dea-7c7cf01097b9",
  "scope": "PRIVATE",
  "systemKey": null,
  "name": "OMEGA-TEST: TPO Rotation to POC",
  "description": "Inside the prior session's value area, price tends to rotate toward the prior point of control. Two required gates - inside prior value, and at least 0.25% of room to the prior POC - block anything else before the agent is billed. UP when the prior POC is above the close, DOWN when below. Prior-session columns only, so it is live all day. Routing weights and trade management mirror the vendor's validated 1h intraday fade playbook.",
  "tagline": "Fade the edge of prior value back toward the prior point of control",
  "visibility": "UNLISTED",
  "timeframe": "1h",
  "cadence": "INTRADAY",
  "regimeTimeframe": "4h",
  "marketReadText": "",
  "sections": [
   {
    "kind": "custom",
    "sectionKey": "custom:f56b9e15-78a6-8870-8f81-aa66e7ae78eb",
    "title": "TPO rotation to prior POC",
    "benchmarkTicker": null,
    "notes": "Positive spread means the first metric sits above the second.",
    "columns": [
     {
      "metric": "PRIOR_TPO_VAL",
      "transformId": "spread",
      "timeframe": {
       "rel": "anchor"
      },
      "inputs": [
       {
        "metric": "CLOSE"
       }
      ]
     },
     {
      "metric": "PRIOR_TPO_VAH",
      "transformId": "spread",
      "timeframe": {
       "rel": "anchor"
      },
      "inputs": [
       {
        "metric": "CLOSE"
       }
      ]
     },
     {
      "metric": "PRIOR_TPO_POC",
      "transformId": "spread",
      "timeframe": {
       "rel": "anchor"
      },
      "inputs": [
       {
        "metric": "CLOSE"
       }
      ]
     },
     {
      "metric": "PRIOR_TPO_VAH",
      "transformId": "spread",
      "timeframe": {
       "rel": "anchor"
      },
      "inputs": [
       {
        "metric": "PRIOR_TPO_VAL"
       }
      ]
     },
     {
      "metric": "RSI14",
      "transformId": "value",
      "timeframe": {
       "rel": "anchor"
      }
     }
    ]
   }
  ],
  "conditions": [
   {
    "conditionKey": "ROTATE_UP_TO_POC",
    "name": "Inside prior value, prior POC above the close: rotate up",
    "definition": {
     "kind": "group",
     "op": "ALL",
     "members": [
      {
       "kind": "conditionRef",
       "conditionKey": "INSIDE_PRIOR_VALUE"
      },
      {
       "kind": "clause",
       "column": {
        "sectionKey": "custom:f56b9e15-78a6-8870-8f81-aa66e7ae78eb",
        "header": "pTpoPOC_close_spread"
       },
       "op": "gte",
       "value": 0.25
      }
     ]
    },
    "verdict": "UP",
    "required": false,
    "exit": false,
    "clock": "LIVE",
    "closes": 1
   },
   {
    "conditionKey": "ROTATE_DOWN_TO_POC",
    "name": "Inside prior value, prior POC below the close: rotate down",
    "definition": {
     "kind": "group",
     "op": "ALL",
     "members": [
      {
       "kind": "conditionRef",
       "conditionKey": "INSIDE_PRIOR_VALUE"
      },
      {
       "kind": "clause",
       "column": {
        "sectionKey": "custom:f56b9e15-78a6-8870-8f81-aa66e7ae78eb",
        "header": "pTpoPOC_close_spread"
       },
       "op": "lte",
       "value": -0.25
      }
     ]
    },
    "verdict": "DOWN",
    "required": false,
    "exit": false,
    "clock": "LIVE",
    "closes": 1
   },
   {
    "conditionKey": "AT_PRIOR_POC",
    "name": "Inside prior value but sitting on the prior POC: no room",
    "definition": {
     "kind": "group",
     "op": "ALL",
     "members": [
      {
       "kind": "conditionRef",
       "conditionKey": "INSIDE_PRIOR_VALUE"
      },
      {
       "kind": "clause",
       "column": {
        "sectionKey": "custom:f56b9e15-78a6-8870-8f81-aa66e7ae78eb",
        "header": "pTpoPOC_close_spread"
       },
       "op": "between",
       "low": -0.25,
       "high": 0.25
      }
     ]
    },
    "verdict": "NEITHER",
    "required": false,
    "exit": false,
    "clock": "LIVE",
    "closes": 1
   },
   {
    "conditionKey": "OUTSIDE_PRIOR_VALUE",
    "name": "Close outside the prior value area: not a rotation setup",
    "definition": {
     "kind": "group",
     "op": "NOT",
     "members": [
      {
       "kind": "conditionRef",
       "conditionKey": "INSIDE_PRIOR_VALUE"
      }
     ]
    },
    "verdict": "NEITHER",
    "required": false,
    "exit": false,
    "clock": "LIVE",
    "closes": 1
   },
   {
    "conditionKey": "INSIDE_PRIOR_VALUE",
    "name": "Close inside the prior session value area",
    "definition": {
     "kind": "group",
     "op": "ALL",
     "members": [
      {
       "kind": "clause",
       "column": {
        "sectionKey": "custom:f56b9e15-78a6-8870-8f81-aa66e7ae78eb",
        "header": "pTpoVAL_close_spread"
       },
       "op": "lt",
       "value": 0
      },
      {
       "kind": "clause",
       "column": {
        "sectionKey": "custom:f56b9e15-78a6-8870-8f81-aa66e7ae78eb",
        "header": "pTpoVAH_close_spread"
       },
       "op": "gt",
       "value": 0
      }
     ]
    },
    "verdict": null,
    "required": true,
    "exit": false,
    "clock": "LIVE",
    "closes": 1
   },
   {
    "conditionKey": "ROOM_TO_POC",
    "name": "At least 0.25% of room between the close and the prior POC",
    "definition": {
     "kind": "group",
     "op": "ANY",
     "members": [
      {
       "kind": "conditionRef",
       "conditionKey": "ROTATE_UP_TO_POC"
      },
      {
       "kind": "conditionRef",
       "conditionKey": "ROTATE_DOWN_TO_POC"
      }
     ]
    },
    "verdict": null,
    "required": true,
    "exit": false,
    "clock": "LIVE",
    "closes": 1
   }
  ],
